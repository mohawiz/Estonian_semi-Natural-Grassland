# Cloudflare Pages and Netlify read this file. (Cloudflare Pages needs no
# redirect rule: with no 404.html in the output it serves index.html for
# unknown paths, i.e. SPA mode.)
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://archive-api.open-meteo.com; script-src 'self'; frame-src blob:; object-src 'none'; base-uri 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
