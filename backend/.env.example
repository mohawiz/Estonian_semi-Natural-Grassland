# Copy to backend/.env and fill in. Never commit .env.

# Groq API key (free at https://console.groq.com/keys). Server-side only.
GROQ_API_KEY=

# Postgres with pgvector, e.g. a free Neon database:
# postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Leave empty to use an in-memory store (fine for trying it out, not for production).
DATABASE_URL=

# Model and generation settings. Low temperature keeps answers close to the sources.
# Check which models your key can use: the API's /api/health reports a missing one.
GROQ_MODEL=openai/gpt-oss-120b
REWRITE_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=medium
TEMPERATURE=0.2
TOP_P=1.0
MAX_TOKENS=2000

# Retrieval
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=6
MIN_SIMILARITY=0.30

# Web origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://estonia-grasslands.vercel.app

# Requests per IP per 10 minutes, to protect the free Groq quota
RATE_LIMIT=30
